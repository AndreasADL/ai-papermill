projects/*/data/raw/**
projects/*/data/processed/**
!projects/*/data/raw/**/
!projects/*/data/processed/**/

# ...except small, redistributable artefacts needed for verification
!projects/astrology-efficacy/data/raw/bts/manifest.csv
